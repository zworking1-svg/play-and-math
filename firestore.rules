rules_version = '2';

// Правила для онлайн-рейтинга «Считай с Филей».
// Читать рейтинг может любой, добавлять — только правдоподобные записи, менять и удалять — никто.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'age', 'score', 'level', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 14
        && request.resource.data.age in ['young', 'mid', 'old']
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 200
        && request.resource.data.score is int
        && request.resource.data.score > 0
        // за один уровень (5 ответов) больше 3000 очков набрать нельзя
        && request.resource.data.score <= request.resource.data.level * 3000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
